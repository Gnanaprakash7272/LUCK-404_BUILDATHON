# CYVORA Environment Variables
# ==============================
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file with actual secrets to version control.

# ── PostgreSQL ──────────────────────────────────────────────
# Required for database persistence. Format:
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cyvora

# ── JWT Authentication ───────────────────────────────────────
# Required. Generate a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep this value secret and do NOT hardcode it in source code.
JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret

# JWT signing algorithm. HS256 is the recommended default.
JWT_ALGORITHM=HS256

# How long access tokens are valid (in minutes). Default: 60.
JWT_EXPIRE_MINUTES=60
